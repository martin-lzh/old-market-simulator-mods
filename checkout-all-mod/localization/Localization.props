<Project>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Catalog.cs" Link="Localization/Catalog.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)GameText.cs" Link="Localization/GameText.cs" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)messages.txt" LogicalName="OldMarket.Messages" />
    <Reference Include="Unity.Localization"><HintPath>$(ManagedDir)/Unity.Localization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.ResourceManager"><HintPath>$(ManagedDir)/Unity.ResourceManager.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
